
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model News {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   String
  tags     String[]
  author    String
  authorEmail     String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
